# Where contact form submissions are delivered.
# Point this at a Slack incoming webhook, a CRM intake endpoint, an email relay
# (Resend / Postmark / SendGrid), or an automation platform such as Zapier.
# Until it is set, /api/contact returns 503 with a message telling the visitor
# to email directly — it never silently swallows an enquiry.
CONTACT_WEBHOOK_URL=

# --- QA scripts only (npm run qa) ---
# Base URL the accessibility and responsive gates run against.
QA_BASE_URL=http://localhost:3000
# Optional: absolute path to a Chromium binary. Leave unset to use the one
# Playwright installs itself.
QA_CHROMIUM_PATH=
