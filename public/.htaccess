# CyberXSolutions — static export on Apache / LiteSpeed (Hostinger shared hosting).
# Next.js emits directory-style URLs (/about/index.html), which Apache serves
# natively. These rules add the security headers, caching and HTTPS redirect
# that next.config.mjs applies when Node is serving the site instead.

# ---------- Index priority ----------
# Hostinger provisions public_html with a default.php placeholder, and Apache's
# default DirectoryIndex prefers .php over .html — which would serve the
# placeholder instead of the site. Pin the order explicitly.
DirectoryIndex index.html index.htm

# ---------- Force HTTPS + canonical host ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Canonical to the apex domain; delete this block if you prefer www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-DNS-Prefetch-Control "on"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ---------- Extensionless generated images ----------
# Next exports social cards as `opengraph-image` / `apple-icon` with no file
# extension. Without this Apache serves them as octet-stream and every social
# scraper rejects the card.
<IfModule mod_mime.c>
  <FilesMatch "^(opengraph-image|twitter-image|apple-icon|icon)$">
    ForceType image/png
  </FilesMatch>
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets are immutable.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
  # HTML must revalidate so a redeploy is picked up immediately.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------- 404 ----------
ErrorDocument 404 /404.html

# ---------- Don't serve dotfiles ----------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
